# Copy this file to .env and fill in the keys for the engines you use.
# The google, ollama and apple engines need no key.

# DeepL (--engine deepl). Free API keys end in ":fx". https://www.deepl.com/pro-api
DEEPL_API_KEY=

# Azure Translator (--engine azure). The region is required for regional resources, e.g. westeurope.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Google Cloud Translation (--engine google-cloud)
GOOGLE_CLOUD_API_KEY=

# Anthropic Claude (--engine claude). An `ant auth login` profile also works.
ANTHROPIC_API_KEY=

# Google Gemini (--engine gemini). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama (--engine ollama). Defaults to http://localhost:11434
OLLAMA_HOST=
